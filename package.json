{
  "name": "steamworkshopsync",
  "version": "1.0.1",
  "private": true,
  "description": "Keeps Steam Workshop subscriptions in sync across groups of Steam accounts",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsc && node --test --test-concurrency=1 \"test/*.test.mjs\""
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "cheerio": "^1.2.0",
    "fastify": "^5.6.0",
    "qrcode": "^1.5.4",
    "steam-session": "^1.9.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.9.0"
  }
}
